<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordManagerLocal.Windows.Ipc\PasswordManagerLocal.Windows.Ipc.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Backend\PasswordManagerLocal.Backend.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Windows.Agent\PasswordManagerLocal.Windows.Agent.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal\PasswordManagerLocal.Windows\PasswordManagerLocal.Windows.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Windows.TestHost\PasswordManagerLocal.Windows.TestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <ProcessTestHostPlatformSegment Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)\</ProcessTestHostPlatformSegment>
    <ProcessTestHostOutputDirectory>$(MSBuildProjectDirectory)\..\PasswordManagerLocal.Windows.TestHost\bin\$(ProcessTestHostPlatformSegment)$(Configuration)\net10.0-windows\</ProcessTestHostOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyWindowsProcessTestHost" AfterTargets="Build">
    <ItemGroup>
      <ProcessTestHostFile Include="$(ProcessTestHostOutputDirectory)**\*"
                           Exclude="$(ProcessTestHostOutputDirectory)**\*.pdb;$(ProcessTestHostOutputDirectory)**\*.xml" />
    </ItemGroup>
    <Error Condition="'@(ProcessTestHostFile)' == ''"
           Text="The Windows process test host output was not found at $(ProcessTestHostOutputDirectory)." />
    <Copy SourceFiles="@(ProcessTestHostFile)"
          DestinationFiles="@(ProcessTestHostFile->'$(OutDir)TestHosts\ProcessLockHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
