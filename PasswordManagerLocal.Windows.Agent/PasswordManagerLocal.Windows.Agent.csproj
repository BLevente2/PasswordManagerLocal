<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PasswordManagerLocal.Backend\PasswordManagerLocal.Backend.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Backend.Hosting\PasswordManagerLocal.Backend.Hosting.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Backend.Windows\PasswordManagerLocal.Backend.Windows.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Runtime.Abstractions\PasswordManagerLocal.Runtime.Abstractions.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Windows.EndpointRpc\PasswordManagerLocal.Windows.EndpointRpc.csproj" />
    <ProjectReference Include="..\PasswordManagerLocal.Windows.Ipc\PasswordManagerLocal.Windows.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PasswordManagerLocal.Windows.Ipc.Test" />
  </ItemGroup>
</Project>
