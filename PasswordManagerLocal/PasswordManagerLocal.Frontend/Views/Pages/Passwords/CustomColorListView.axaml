<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.Frontend.ViewModels.Pages"
    xmlns:passwords="clr-namespace:PasswordManagerLocal.Frontend.Views.Pages.Passwords"
    x:Class="PasswordManagerLocal.Frontend.Views.Pages.Passwords.CustomColorListView"
    x:DataType="vm:PasswordsViewModel">
  <StackPanel Spacing="12">
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button
            Classes="ghost iconButton"
            Command="{Binding BackFromCustomColorListCommand}"
            ToolTip.Tip="{Binding CustomColorsBackToEditorLabel}">
          <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
        </Button>
        <TextBlock
            Text="{Binding CustomColorsTitle}"
            Classes="sectionTitle"
            VerticalAlignment="Center"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <passwords:CustomColorToolbarView Margin="0" />

    <Border Classes="card" IsVisible="{Binding IsCustomColorListEmpty}">
      <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="520">
        <PathIcon Classes="largeEmptyStateIcon" Data="{StaticResource AddIconGeometry}" HorizontalAlignment="Center" />
        <TextBlock
            Text="{Binding CustomColorsEmptyTitle}"
            Classes="sectionTitle"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Text="{Binding CustomColorsEmptyDescription}"
            Classes="subtleText"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            Classes="primary"
            HorizontalAlignment="Center"
            Command="{Binding OpenCustomColorPickerCommand}"
            Content="{Binding CustomColorsEmptyAddLabel}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsCustomColorSearchResultEmpty}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding CustomColorsSearchEmptyTitle}" Classes="sectionTitle" />
        <TextBlock
            Text="{Binding CustomColorsSearchEmptyDescription}"
            Classes="subtleText"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding CustomColors}" HorizontalAlignment="Stretch" IsVisible="{Binding HasCustomColors}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CustomColorItemViewModel">
          <Border
              Classes="interactiveListItem"
              PointerEntered="InteractiveListItem_PointerEntered"
              PointerExited="InteractiveListItem_PointerExited"
              PointerPressed="InteractiveListItem_PointerPressed"
              PointerReleased="InteractiveListItem_PointerReleased"
              Margin="0,0,0,8"
              Padding="14"
              CornerRadius="16"
              HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="12" PointerEntered="InteractiveListItem_PointerEntered">
              <Border Background="{Binding ColorBrush}" CornerRadius="6" />
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding DisplayName}"
                    FontWeight="SemiBold"
                    Foreground="{Binding ColorBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding ColorCode}"
                    Classes="subtleText"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
              </StackPanel>
              <Button
                  Grid.Column="2"
                  Classes="danger iconButton"
                  PointerEntered="InteractiveListItem_PointerEntered"
                  Command="{Binding DeleteCommand}"
                  ToolTip.Tip="{Binding DeleteLabel}"
                  AutomationProperties.Name="{Binding DeleteLabel}">
                <PathIcon
                    Classes="actionButtonIcon"
                    Data="{StaticResource DeleteIconGeometry}" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
