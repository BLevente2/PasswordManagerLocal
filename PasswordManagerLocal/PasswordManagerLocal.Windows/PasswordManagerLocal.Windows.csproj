<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- Keep Windows releases self-contained and use conservative partial trimming.
         Partial trimming removes trim-compatible framework code while preserving
         application and third-party assemblies that rely on reflection or XAML. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Release builds do not attach a debugger, create crash dumps, emit EventSource
         events/metrics, or use HTTP/3. Keep normal exception messages and stack-trace
         behavior, but let the trimmer remove these unused diagnostics features. -->
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <Http3Support>false</Http3Support>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- EF Core and the application assemblies use runtime metadata, expression trees,
         XAML activation, and reflection. Preserve them completely while still trimming
         the self-contained framework and trim-compatible dependencies. -->
    <TrimmerRootAssembly Include="PasswordManagerLocal.Backend" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Frontend" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Abstractions" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Relational" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" />
    <TrimmerRootAssembly Include="ReactiveUI" />
    <TrimmerRootAssembly Include="DynamicData" />
    <TrimmerRootAssembly Include="Splat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordManagerLocal.Frontend\PasswordManagerLocal.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Tools\ConfigureWindowsFirewall.bat" Link="ConfigureWindowsFirewall.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\ConfigureWindowsFirewall.ps1" Link="ConfigureWindowsFirewall.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="OptimizeWindowsReleasePublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(PublishDir)' != ''">
    <!-- The Avalonia package currently marks its designer protocol as runtime assets,
         and the CoreCLR runtime pack includes dump/debugger tools by default. The
         canonical Windows publish does not use either feature set, so post-process
         the folder and its generated .deps.json together. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\OptimizeWindowsPublish.ps1&quot; -OutputPath &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))&quot;" />
  </Target>
</Project>