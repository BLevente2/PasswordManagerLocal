<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Views.Auth.RegistrationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Views.Controls"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Auth"
    x:DataType="vm:RegistrationViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding RegisterCommand}" />
  </UserControl.KeyBindings>

  <ScrollViewer x:Name="PageScrollViewer">
    <Grid Margin="16,8,16,16">
      <Border Classes="card" HorizontalAlignment="Center" MaxWidth="560" MinWidth="280">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Classes="ghost iconButton"
                    IsVisible="{Binding IsBackButtonVisible}"
                    Command="{Binding NavigateBackCommand}"
                    
                    ToolTip.Tip="{Binding BackLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Classes="pageTitle" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subtitle}" Classes="subtleText" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{Binding BusyText}" Classes="subtleText" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding UsernameLabel}" />
              <TextBox Text="{Binding Username}"
                       Watermark="{Binding UsernamePlaceholder}"
                       TextInputOptions.AutoCapitalization="False"
                       TextInputOptions.ShowSuggestions="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{Binding EmailLabel}" />
              <TextBox Text="{Binding Email}"
                       Watermark="{Binding EmailPlaceholder}"
                       TextInputOptions.ContentType="Email"
                       TextInputOptions.AutoCapitalization="False"
                       TextInputOptions.ShowSuggestions="False" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding FirstNameLabel}" />
              <TextBox Text="{Binding FirstName}"
                       Watermark="{Binding FirstNamePlaceholder}"
                       TextInputOptions.ContentType="Name"
                       TextInputOptions.AutoCapitalization="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="{Binding LastNameLabel}" />
              <TextBox Text="{Binding LastName}"
                       Watermark="{Binding LastNamePlaceholder}"
                       TextInputOptions.ContentType="Name"
                       TextInputOptions.AutoCapitalization="True" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="2">
              <TextBlock Grid.Column="0" Text="{Binding PasswordLabel}" VerticalAlignment="Center" />
              <controls:PasswordStrengthInfoButton
                  Grid.Column="1"
                  Title="{Binding PasswordStrengthInfoTitle}"
                  Body="{Binding PasswordStrengthInfoBody}"
                  AccessibleLabel="{Binding PasswordStrengthInfoAccessibleLabel}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding Password}"
                       PasswordChar="{Binding PasswordMaskCharacter}"
                       Watermark="{Binding PasswordPlaceholder}"
                       TextInputOptions.ContentType="Password"
                       TextInputOptions.IsSensitive="True"
                       TextInputOptions.AutoCapitalization="False"
                       TextInputOptions.ShowSuggestions="False" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      Content="{Binding PasswordVisibilityToggleText}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            </Grid>
            <controls:PasswordStrengthIndicator
                Strength="{Binding PasswordStrength}"
                Label="{Binding PasswordStrengthLabel}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ConfirmPasswordLabel}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding ConfirmPassword}"
                       PasswordChar="{Binding ConfirmPasswordMaskCharacter}"
                       Watermark="{Binding ConfirmPasswordPlaceholder}"
                       TextInputOptions.ContentType="Password"
                       TextInputOptions.IsSensitive="True"
                       TextInputOptions.AutoCapitalization="False"
                       TextInputOptions.ShowSuggestions="False"
                       TextInputOptions.ReturnKeyType="Done" />
              <Button Grid.Column="1"
                      Classes="ghost"
                      Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                      Content="{Binding ConfirmPasswordVisibilityToggleText}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
            </Grid>
          </StackPanel>

          <CheckBox IsChecked="{Binding RememberMe}" Content="{Binding RememberMeLabel}" />

          <TextBlock Text="{Binding StatusMessage}" Classes="errorText" IsVisible="{Binding HasStatusMessage}" TextWrapping="Wrap" />

          <Button Classes="primary"
                  Command="{Binding RegisterCommand}"
                  Content="{Binding RegisterButtonLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>

          <Border Classes="divider" />

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding AlreadyHaveAccountText}" Classes="subtleText" TextWrapping="Wrap" />
            <Button Classes="ghost"
                    Command="{Binding NavigateToLoginCommand}"
                    Content="{Binding NavigateToLoginLabel}" >
              <PathIcon Classes="smallUiIcon" Data="{StaticResource BackIconGeometry}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
