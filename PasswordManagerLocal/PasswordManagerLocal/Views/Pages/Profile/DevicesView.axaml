<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    xmlns:profile="clr-namespace:PasswordManagerLocal.Views.Pages.Profile"
    x:Class="PasswordManagerLocal.Views.Pages.Profile.DevicesView"
    x:DataType="vm:ProfileViewModel"
    IsVisible="{Binding IsDevicesMainPage}">

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:DeviceListPaneTransitionViewModel">
      <profile:DeviceListView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:DeviceAddPaneTransitionViewModel">
      <profile:DeviceAddView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:DeviceDetailsPaneTransitionViewModel">
      <profile:DeviceDetailsView DataContext="{Binding Owner}" />
    </DataTemplate>
    <DataTemplate x:DataType="vm:DeviceDisconnectPaneTransitionViewModel">
      <profile:DeviceDisconnectView DataContext="{Binding Owner}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsDevicesMainPage}">
    <profile:DeviceToolbarView Grid.Row="0" Margin="0,0,0,12" />

    <ScrollViewer x:Name="DeviceListScrollViewer" Grid.Row="1">
      <Grid>
        <TransitioningContentControl
            ClipToBounds="True"
            Content="{Binding CurrentAnimatedDevicePaneViewModel}"
            IsTransitionReversed="{Binding IsDevicePaneTransitionReversed}"
            IsVisible="{Binding IsAndroidPaneTransitionEnabled}">
          <TransitioningContentControl.PageTransition>
            <PageSlide Duration="0:0:0.20"
                       Orientation="Horizontal"
                       SlideInEasing="CubicEaseOut"
                       SlideOutEasing="CubicEaseIn" />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <StackPanel Spacing="12"
                    IsVisible="{Binding IsStaticPaneContentVisible}">
          <profile:DeviceListView IsVisible="{Binding IsDeviceListPaneVisible}" />
          <profile:DeviceAddView IsVisible="{Binding IsDeviceAddPaneVisible}" />
          <profile:DeviceDetailsView IsVisible="{Binding IsDeviceDetailsPaneVisible}" />
          <profile:DeviceDisconnectView IsVisible="{Binding IsDeviceDisconnectPaneVisible}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
