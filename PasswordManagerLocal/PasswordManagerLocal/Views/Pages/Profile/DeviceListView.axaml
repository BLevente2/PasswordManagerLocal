<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Views.Pages.Profile.DeviceListView"
    x:DataType="vm:ProfileViewModel"
    IsVisible="{Binding IsDeviceListPaneVisible}">
  <StackPanel Spacing="12" IsVisible="{Binding IsDeviceListPaneVisible}">
    <Border Classes="card" IsVisible="{Binding IsDeviceListEmpty}">
      <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="520">
        <PathIcon Classes="largeEmptyStateIcon" Data="{StaticResource AddIconGeometry}" HorizontalAlignment="Center" />
        <TextBlock
            Text="{Binding DevicesEmptyTitle}"
            Classes="sectionTitle"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Text="{Binding DevicesEmptyDescription}"
            Classes="subtleText"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            Classes="primary"
            HorizontalAlignment="Center"
            Command="{Binding BeginAddDeviceCommand}"
            Content="{Binding AddDeviceLabel}" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding IsDeviceSearchResultEmpty}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding DeviceSearchEmptyTitle}" Classes="sectionTitle" />
        <TextBlock Text="{Binding DeviceSearchEmptyDescription}" Classes="subtleText" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Devices}" HorizontalAlignment="Stretch" IsVisible="{Binding HasDevices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceItemViewModel">
          <Border
              Margin="0,0,0,8"
              Padding="14"
              CornerRadius="16"
              BorderThickness="1"
              BorderBrush="#33808080"
              Background="#08808080"
              HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HorizontalAlignment="Stretch">
              <Button
                  Grid.Column="0"
                  Classes="ghost"
                  Command="{Binding ViewCommand}"
                  Padding="0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                  <WrapPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="  •  " Classes="subtleText" />
                    <TextBlock Text="{Binding TrustStateText}" Classes="subtleText" />
                  </WrapPanel>
                  <WrapPanel>
                    <Border Padding="8,3" CornerRadius="10" Background="#22808080" Margin="0,0,6,6">
                      <TextBlock Text="{Binding DeviceTypeText}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border
                        Padding="8,3"
                        CornerRadius="10"
                        Background="#223080FF"
                        IsVisible="{Binding IsCurrentDevice}"
                        Margin="0,0,6,6">
                      <TextBlock Text="{Binding CurrentDeviceLabel}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border
                        Padding="8,3"
                        CornerRadius="10"
                        Background="#22D13438"
                        IsVisible="{Binding IsBlocked}"
                        Margin="0,0,6,6">
                      <TextBlock
                          Text="{Binding BlockedLabel}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Foreground="#FFD13438" />
                    </Border>
                    <Border Padding="8,3" CornerRadius="10" Background="#22808080" Margin="0,0,6,6">
                      <TextBlock Text="{Binding SyncStateText}" FontSize="12" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Button>
              <ToggleSwitch
                  Grid.Column="1"
                  IsChecked="{Binding IsSyncOn, Mode=OneWay}"
                  Command="{Binding ToggleSyncCommand}"
                  OnContent="{Binding SyncToggleOnLabel}"
                  OffContent="{Binding SyncToggleOffLabel}"
                  VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
