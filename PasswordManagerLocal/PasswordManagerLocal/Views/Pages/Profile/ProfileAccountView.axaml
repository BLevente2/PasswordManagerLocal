<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    xmlns:profile="clr-namespace:PasswordManagerLocal.Views.Pages.Profile"
    x:Class="PasswordManagerLocal.Views.Pages.Profile.ProfileAccountView"
    x:DataType="vm:ProfileViewModel"
    IsVisible="{Binding IsProfileMainPage}">
  <StackPanel IsVisible="{Binding IsProfileMainPage}" Spacing="12" HorizontalAlignment="Stretch">
    <profile:ProfileTabsView />
    <profile:ProfilePersonalInfoView />
    <profile:ProfileUsernameView />
    <profile:ProfileMasterPasswordView />
    <profile:ProfileDeleteAccountView />
  </StackPanel>
</UserControl>
