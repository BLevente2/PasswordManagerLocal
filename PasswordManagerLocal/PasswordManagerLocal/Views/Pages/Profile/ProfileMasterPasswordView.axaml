<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Views.Pages.Profile.ProfileMasterPasswordView"
    x:DataType="vm:ProfileViewModel"
    IsVisible="{Binding IsProfilePasswordPaneVisible}">
  <StackPanel Spacing="12" IsVisible="{Binding IsProfilePasswordPaneVisible}">
    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button
              Classes="ghost iconButton"
              Command="{Binding BackToProfileCommand}"
              Content="←"
              ToolTip.Tip="{Binding BackToProfileLabel}" />
          <TextBlock
              Text="{Binding ChangeMasterPasswordLabel}"
              Classes="sectionTitle"
              VerticalAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding CurrentPasswordLabel}" Classes="subtleText" />
          <TextBox Text="{Binding CurrentPassword}" PasswordChar="●" Watermark="{Binding CurrentPasswordPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ChangeMasterPasswordCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding NewPasswordLabel}" Classes="subtleText" />
          <TextBox Text="{Binding NewPassword}" PasswordChar="●" Watermark="{Binding NewPasswordPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ChangeMasterPasswordCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ConfirmNewPasswordLabel}" Classes="subtleText" />
          <TextBox
              Text="{Binding ConfirmNewPassword}"
              PasswordChar="●"
              Watermark="{Binding ConfirmNewPasswordPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ChangeMasterPasswordCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button
              Classes="primary"
              Command="{Binding ChangeMasterPasswordCommand}"
              Content="{Binding ChangeMasterPasswordLabel}"
              Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
