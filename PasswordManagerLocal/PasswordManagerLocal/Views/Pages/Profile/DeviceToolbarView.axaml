<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    x:Class="PasswordManagerLocal.Views.Pages.Profile.DeviceToolbarView"
    x:DataType="vm:ProfileViewModel"
    IsVisible="{Binding IsDeviceToolbarVisible}">
  <Border Classes="card" IsVisible="{Binding IsDeviceToolbarVisible}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MaxWidth="560" HorizontalAlignment="Center">
      <Border Classes="toolbarGroup" Grid.Column="0" MinWidth="0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinWidth="0">
          <TextBlock Text="🔍" VerticalAlignment="Center" FontSize="16" ToolTip.Tip="{Binding DeviceSearchLabel}" />
          <TextBox
              Grid.Column="1"
              Text="{Binding DeviceSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              Watermark="{Binding DeviceSearchPlaceholder}"
              MinWidth="0"
              TextInputOptions.ContentType="Search"
              TextInputOptions.AutoCapitalization="False"
              TextInputOptions.ReturnKeyType="Search">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchDevicesCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </Grid>
      </Border>
      <Button
          Classes="ghost iconButton"
          Grid.Column="1"
          Width="48"
          MinWidth="48"
          Content="⇅"
          ToolTip.Tip="{Binding DeviceSortLabel}">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem
                Header="{Binding DeviceSortNameAscMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="name-asc" />
            <MenuItem
                Header="{Binding DeviceSortNameDescMenuLabel}"
                Command="{Binding SelectDeviceSortOptionCommand}"
                CommandParameter="name-desc" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button
          Classes="primary iconButton"
          Grid.Column="2"
          Width="48"
          MinWidth="48"
          Command="{Binding BeginAddDeviceCommand}"
          Content="{Binding AddDeviceIconLabel}"
          ToolTip.Tip="{Binding AddDeviceLabel}" />
    </Grid>
  </Border>
</UserControl>
