<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Views.Pages.PasswordListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Views.Controls"
    xmlns:passwords="clr-namespace:PasswordManagerLocal.Views.Pages.Passwords"
    x:DataType="vm:PasswordsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding ExecutePrimaryActionCommand}" />
  </UserControl.KeyBindings>

  <Grid>
    <ScrollViewer>
      <StackPanel Margin="16,4,16,16" Spacing="12" HorizontalAlignment="Stretch">
        <passwords:PasswordToolbarView />
        <controls:OperationMessageView />
        <passwords:PasswordListPaneView />
        <passwords:PasswordEditorView />
        <passwords:PasswordColorPickerView />
        <passwords:PasswordDetailsView />
      </StackPanel>
    </ScrollViewer>

    <passwords:PasswordDeleteDialogView />
  </Grid>
</UserControl>
