<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManagerLocal.Views.Pages.ProfileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PasswordManagerLocal.ViewModels.Pages"
    xmlns:controls="clr-namespace:PasswordManagerLocal.Views.Controls"
    xmlns:profile="clr-namespace:PasswordManagerLocal.Views.Pages.Profile"
    x:DataType="vm:ProfileViewModel">

  <Grid>
    <ScrollViewer>
      <StackPanel Margin="16,4,16,16" Spacing="12">
        <controls:OperationMessageView />
        <profile:ProfileAccountView />
        <profile:DevicesView />
      </StackPanel>
    </ScrollViewer>

    <profile:LocalSyncDialogView />
  </Grid>
</UserControl>
