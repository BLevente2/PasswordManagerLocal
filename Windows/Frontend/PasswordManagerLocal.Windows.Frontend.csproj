<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PasswordManagerLocal</AssemblyName>
    <RootNamespace>PasswordManagerLocal.Windows.Frontend</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
    <SignAssembly>False</SignAssembly>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- Keep Windows releases self-contained and use conservative partial trimming.
         Partial trimming removes trim-compatible framework code while preserving
         application and third-party assemblies that rely on reflection or XAML. -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- Release builds do not attach a debugger, create crash dumps, emit EventSource
         events/metrics, or use HTTP/3. Keep normal exception messages and stack-trace
         behavior, but let the trimmer remove these unused diagnostics features. -->
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <Http3Support>false</Http3Support>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
    <!-- The frontend application assemblies use XAML activation, generated JSON
         metadata, and reflection. Preserve the UI/client boundary assemblies while
         still trimming the self-contained framework and trim-compatible dependencies. -->
    <TrimmerRootAssembly Include="PasswordManagerLocal.Common.Frontend" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Common.Contracts" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Windows.EndpointRpc.Contracts" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Windows.EndpointRpc.Client" />
    <TrimmerRootAssembly Include="PasswordManagerLocal.Windows.Ipc" />
    <TrimmerRootAssembly Include="ReactiveUI" />
    <TrimmerRootAssembly Include="DynamicData" />
    <TrimmerRootAssembly Include="Splat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Frontend\PasswordManagerLocal.Common.Frontend.csproj" />
    <ProjectReference Include="..\..\Common\Contracts\PasswordManagerLocal.Common.Contracts.csproj" />
    <ProjectReference Include="..\EndpointRpc\Client\PasswordManagerLocal.Windows.EndpointRpc.Client.csproj" />
    <ProjectReference Include="..\IPC\PasswordManagerLocal.Windows.Ipc.csproj" />
    <ProjectReference Include="..\Agent\PasswordManagerLocal.Windows.Agent.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Tools\ConfigureWindowsFirewall.bat" Link="ConfigureWindowsFirewall.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Tools\ConfigureWindowsFirewall.ps1" Link="ConfigureWindowsFirewall.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <WindowsAgentProject>$(MSBuildProjectDirectory)\..\Agent\PasswordManagerLocal.Windows.Agent.csproj</WindowsAgentProject>
    <WindowsAgentDeploymentDirectoryName>AgentRuntime\</WindowsAgentDeploymentDirectoryName>
  </PropertyGroup>

  <Target Name="PublishWindowsAgentForBuild"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <WindowsAgentBuildDeploymentDirectory>$([System.IO.Path]::GetFullPath('$(TargetDir)$(WindowsAgentDeploymentDirectoryName)'))</WindowsAgentBuildDeploymentDirectory>
      <WindowsAgentSourceDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\Agent\'))</WindowsAgentSourceDirectory>
    </PropertyGroup>
    <Error
      Condition="'$(TargetDir)' == ''"
      Text="The Windows UI target directory was not available for agent deployment." />
    <Error
      Condition="'$(WindowsAgentBuildDeploymentDirectory)' == '$(WindowsAgentSourceDirectory)'"
      Text="The Windows agent deployment directory must never resolve to the UI source Agent directory." />
    <ItemGroup>
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.exe" />
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.dll" />
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.pdb" />
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.deps.json" />
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.runtimeconfig.json" />
      <_WindowsAgentRootBuildArtifact Include="$(TargetDir)PasswordManagerLocal.Windows.Agent.runtimeconfig.dev.json" />
    </ItemGroup>
    <Delete Files="@(_WindowsAgentRootBuildArtifact)" />
    <RemoveDir Directories="$(WindowsAgentBuildDeploymentDirectory)" />
    <MSBuild Projects="$(WindowsAgentProject)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(WindowsAgentBuildDeploymentDirectory)" />
    <Error
      Condition="!Exists('$(WindowsAgentBuildDeploymentDirectory)PasswordManagerLocal.Windows.Agent.exe')"
      Text="The complete Windows agent deployment was not produced at $(WindowsAgentBuildDeploymentDirectory)." />
  </Target>

  <Target Name="PublishWindowsAgent" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <WindowsAgentPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)$(WindowsAgentDeploymentDirectoryName)'))</WindowsAgentPublishDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(WindowsAgentPublishDirectory)" />
    <MSBuild Projects="$(WindowsAgentProject)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(WindowsAgentPublishDirectory)" />
    <Error
      Condition="!Exists('$(WindowsAgentPublishDirectory)PasswordManagerLocal.Windows.Agent.exe')"
      Text="The complete published Windows agent deployment was not produced at $(WindowsAgentPublishDirectory)." />
  </Target>

  <Target Name="OptimizeWindowsReleasePublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(PublishDir)' != ''">
    <!-- The Avalonia package currently marks its designer protocol as runtime assets,
         and the CoreCLR runtime pack includes dump/debugger tools by default. The
         canonical Windows publish does not use either feature set, so post-process
         the folder and its generated .deps.json together. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)Tools\OptimizeWindowsPublish.ps1&quot; -OutputPath &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(PublishDir)'))&quot;" />
  </Target>

</Project>
